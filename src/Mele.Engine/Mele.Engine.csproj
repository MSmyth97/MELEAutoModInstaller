<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The guide's data ships inside the assembly so a packaged app needs no files next to it. -->
    <EmbeddedResource Include="..\..\guide.json" LogicalName="guide.json" />
    <EmbeddedResource Include="..\..\textures.json" LogicalName="textures.json" />
  </ItemGroup>

</Project>
